{
  "schema_version": "1.0.0",
  "operation_id": "simai.federation.skill_technology.process_contract",
  "technology_id": "framework.component-design-evolution",
  "parent_process_model_id": "framework_frontend_delivery",
  "process_id": "framework-component-design-evolution-process",
  "cycle_id": "framework-component-design-evolution-cycle",
  "owner_skill": "framework",
  "lifecycle_curator": "teamlead",
  "state_machine_id": "framework-component-design-evolution-state-machine",
  "purpose": "Create and evolve ordinary and Smart Components from verified user scenarios while preserving SIMAI Framework semantics, visual coherence, adaptability and compatibility.",
  "scenarios": [
    "create_component",
    "evolve_component",
    "create_smart_projection",
    "evolve_component_and_smart_projection"
  ],
  "stages": [
    {
      "id": "discover",
      "required_outputs": ["component brief", "source provenance", "scenario matrix"]
    },
    {
      "id": "design",
      "required_outputs": ["target contract", "token map", "surface geometry matrix", "Component structure map", "public data-attribute contract", "state geometry matrix", "focus contract", "indicator semantics contract when applicable", "adaptation contract", "compatibility decision"]
    },
    {
      "id": "compare",
      "required_outputs": ["gap matrix"]
    },
    {
      "id": "implement_component",
      "required_outputs": ["base Component verification"]
    },
    {
      "id": "project_smart",
      "required_outputs": ["Smart Component projection decision"]
    },
    {
      "id": "document",
      "required_outputs": ["live examples and documentation", "machine contract evidence"]
    },
    {
      "id": "accept",
      "required_outputs": ["browser and accessibility evidence", "visual-coherence evidence", "technology quality feedback"]
    }
  ],
  "participants": {
    "required": ["framework", "tester"],
    "conditional": ["ux", "designer", "dev", "docs", "docara", "teamlead"]
  },
  "evidence_requirements": [
    "component_brief",
    "source_provenance",
    "scenario_matrix",
    "target_contract",
    "token_map_and_design_literal_audit",
    "surface_geometry_matrix",
    "component_structure_map",
    "public_data_attribute_contract",
    "state_geometry_matrix",
    "focus_contract",
    "indicator_semantics_contract_when_applicable",
    "adaptation_contract",
    "gap_matrix",
    "compatibility_decision",
    "base_component_verification",
    "smart_projection_decision",
    "live_examples",
    "documentation_and_machine_contract",
    "browser_accessibility_responsive_theme_evidence",
    "visual_coherence_evidence",
    "technology_quality_feedback"
  ],
  "validators": [
    "framework-component-design-technology-check",
    "framework-local-checks",
    "federation-process-check",
    "federation-gate-exec"
  ],
  "technology_quality_feedback_policy": {
    "required": true,
    "required_before_terminal_state": true
  },
  "canonical_write_allowed": false,
  "owner_review_required": true
}
