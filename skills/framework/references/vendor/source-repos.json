{
  "schemaVersion": 1,
  "organization": "simai",
  "sourceRoot": "source/simai",
  "notes": [
    "Модель с 2026-10: ui-source — редактируемый источник, ui — сгенерированный выпуск (distr/, включая distr/smart).",
    "simai/ui-smart архивирован (только чтение), simai/ui-loader переименован в ui-source (GitHub-редирект), ui-components — пустая заглушка; в зеркало не синхронизируются."
  ],
  "repos": [
    {
      "name": "ui",
      "remote": "git@github.com:simai/ui.git",
      "defaultBranch": "main",
      "localPath": "source/simai/ui",
      "kind": "runtime-distribution",
      "priority": "primary",
      "authoritativeFor": [
        "shipped core and loader under distr/core",
        "component inventory under distr/component",
        "Smart Component inventory under distr/smart",
        "utility groups under distr/utility",
        "release locks under contracts/releases"
      ]
    },
    {
      "name": "ui-source",
      "remote": "git@github.com:simai/ui-source.git",
      "defaultBranch": "main",
      "localPath": "source/simai/ui-source",
      "kind": "framework-source",
      "priority": "primary",
      "authoritativeFor": [
        "utility source groups under src/utility",
        "component and Smart Component source under src/component and src/smart",
        "core and loader source under src/core",
        "source contracts and tests"
      ]
    },
    {
      "name": "ui-doc",
      "remote": "git@github.com:simai/ui-doc.git",
      "defaultBranch": "main",
      "localPath": "source/simai/ui-doc",
      "kind": "documentation",
      "priority": "primary",
      "authoritativeFor": [
        "official documentation pages under content/ru",
        "guide and reference page structure"
      ]
    },
    {
      "name": "ui-play",
      "remote": "git@github.com:simai/ui-play.git",
      "defaultBranch": "main",
      "localPath": "source/simai/ui-play",
      "kind": "playground-and-examples",
      "priority": "primary",
      "authoritativeFor": [
        "runnable examples",
        "real host/runner wiring"
      ]
    },
    {
      "name": "ui-vscode",
      "remote": "git@github.com:simai/ui-vscode.git",
      "defaultBranch": "main",
      "localPath": "source/simai/ui-vscode",
      "kind": "editor-tooling",
      "priority": "secondary",
      "authoritativeFor": [
        "modifier autocomplete hints",
        "editor-facing utility metadata generation"
      ]
    }
  ]
}
